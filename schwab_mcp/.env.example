# Copy to schwab_mcp/.env and fill in your own values. Never commit .env.
SCHWAB_APP_KEY=your-app-key-here
SCHWAB_APP_SECRET=your-app-secret-here
# Must match the callback URL registered on your Schwab app exactly.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# Where tokens are stored (file is created with 0600 permissions).
TOKEN_PATH=~/.schwab_mcp/schwab_token.json
# "file" (default) or "keyring" to store tokens in the OS keychain.
TOKEN_STORE=file
