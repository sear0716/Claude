# Copy to gap_bot/.env and adjust. This bot only trades a PAPER account.
IBKR_HOST=127.0.0.1
# 7497 = TWS paper, 4002 = IB Gateway paper. Live ports (7496, 4001) are refused.
IBKR_PORT=7497
IBKR_CLIENT_ID=21
PAPER_TRADING=true
PORTFOLIO_VALUE_USD=25000
MAX_TRADE_SIZE_USD=2500

# Optional alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
